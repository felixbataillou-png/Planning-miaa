{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Raleway))/i]",
        "message": "Font not provided by the design system. Available: Raleway."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--color-bg-light",
      "--color-black",
      "--color-body",
      "--color-border",
      "--color-border-card",
      "--color-border-light",
      "--color-footer-bg",
      "--color-heading",
      "--color-hero-bg",
      "--color-link",
      "--color-on-primary",
      "--color-primary",
      "--color-primary-light",
      "--color-sidebar-bg",
      "--color-surface",
      "--color-text",
      "--color-text-dark",
      "--color-topbar-bg",
      "--color-white",
      "--font-sans",
      "--fs-base",
      "--fs-h2",
      "--fs-hero",
      "--fs-lg",
      "--fs-sm",
      "--fs-xs",
      "--fw-bold",
      "--fw-light",
      "--fw-regular",
      "--header-height",
      "--hero-height",
      "--layout-gutter",
      "--layout-max-width",
      "--layout-page-width",
      "--lh-body",
      "--lh-heading",
      "--lh-hero",
      "--radius-card",
      "--radius-none",
      "--shadow-card",
      "--shadow-header",
      "--space-2xl",
      "--space-lg",
      "--space-md",
      "--space-sm",
      "--space-xl",
      "--space-xs",
      "--topbar-height"
    ],
    "tokenKinds": {
      "--color-primary": "color",
      "--color-primary-light": "color",
      "--color-black": "color",
      "--color-text": "font",
      "--color-text-dark": "font",
      "--color-white": "color",
      "--color-bg-light": "color",
      "--color-border": "color",
      "--color-border-card": "color",
      "--color-border-light": "color",
      "--shadow-header": "shadow",
